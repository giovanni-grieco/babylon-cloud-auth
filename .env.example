# start.sh generates .env with random values. To create it by hand, copy this file.

# Central Keycloak (broker)
KC_DB_PASSWORD=change-me
KC_ADMIN_USERNAME=change-me
KC_ADMIN_PASSWORD=change-me
OIDC_CLIENT_SECRET=change-me
# Must be exactly 16, 24 or 32 bytes: openssl rand -hex 16
OAUTH2_PROXY_COOKIE_SECRET=change-me-to-32-characters-long!
CENTRAL_CONTROL_PLANE_SECRET=change-me

# dc-1 Keycloak
DC1_DB_PASSWORD=change-me
DC1_ADMIN_USERNAME=change-me
DC1_ADMIN_PASSWORD=change-me
DC1_BROKER_SECRET=change-me
DC1_CONTROL_PLANE_SECRET=change-me

# dc-2 Keycloak
DC2_DB_PASSWORD=change-me
DC2_ADMIN_USERNAME=change-me
DC2_ADMIN_PASSWORD=change-me
DC2_BROKER_SECRET=change-me
DC2_CONTROL_PLANE_SECRET=change-me
