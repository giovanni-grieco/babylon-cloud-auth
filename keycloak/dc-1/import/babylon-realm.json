{
  "realm": "babylon",
  "enabled": true,
  "sslRequired": "none",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "groups": [
    {
      "name": "service-a"
    },
    {
      "name": "service-b"
    }
  ],
  "clients": [
    {
      "clientId": "central-broker",
      "name": "Central Keycloak",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${DC1_BROKER_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://auth.babylon.test/realms/babylon/broker/dc-1/endpoint"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://auth.babylon.test/realms/babylon/broker/dc-1/endpoint/logout_response"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@dc1.test",
      "firstName": "Alice",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "groups": [
        "service-a"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-babylon"
      ]
    }
  ]
}
