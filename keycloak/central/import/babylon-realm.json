{
  "realm": "babylon",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@babylon.test",
    "fromDisplayName": "Babylon"
  },
  "browserFlow": "home-idp-discovery",
  "authenticationFlows": [
    {
      "alias": "home-idp-discovery",
      "description": "Existing session, otherwise B2B users go to their DC (decided by the HRD oracle) and B2C users sign in here",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "discover-dc",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "b2c-login",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "discover-dc",
      "description": "Ask the HRD oracle and redirect to the DC that owns the user. With no match, the step is only attempted and b2c-login runs.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "babylon-hrd",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "babylon-hrd-config"
        }
      ]
    },
    {
      "alias": "b2c-login",
      "description": "B2C users, stored in this realm",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "broker-create-user",
      "description": "Create the brokered user without prompting or storing a profile",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "babylon-hrd-config",
      "config": {
        "oracle.url": "${HRD_ORACLE_URL}",
        "oracle.timeoutMs": "2000"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "dc-1",
      "displayName": "dc-1",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "hideOnLogin": true,
      "firstBrokerLoginFlowAlias": "broker-create-user",
      "config": {
        "issuer": "http://auth.dc-1.babylon.test/realms/babylon",
        "authorizationUrl": "http://auth.dc-1.babylon.test/realms/babylon/protocol/openid-connect/auth",
        "tokenUrl": "http://auth.dc-1.babylon.test/realms/babylon/protocol/openid-connect/token",
        "jwksUrl": "http://auth.dc-1.babylon.test/realms/babylon/protocol/openid-connect/certs",
        "logoutUrl": "http://auth.dc-1.babylon.test/realms/babylon/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "central-broker",
        "clientSecret": "${DC1_BROKER_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "loginHint": "true",
        "disableUserInfo": "true",
        "sendIdTokenOnLogout": "true",
        "backchannelSupported": "false",
        "syncMode": "FORCE",
        "home.idp.discovery.domains": "dc1.test"
      }
    },
    {
      "alias": "dc-2",
      "displayName": "dc-2",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "hideOnLogin": true,
      "firstBrokerLoginFlowAlias": "broker-create-user",
      "config": {
        "issuer": "http://auth.dc-2.babylon.test/realms/babylon",
        "authorizationUrl": "http://auth.dc-2.babylon.test/realms/babylon/protocol/openid-connect/auth",
        "tokenUrl": "http://auth.dc-2.babylon.test/realms/babylon/protocol/openid-connect/token",
        "jwksUrl": "http://auth.dc-2.babylon.test/realms/babylon/protocol/openid-connect/certs",
        "logoutUrl": "http://auth.dc-2.babylon.test/realms/babylon/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "central-broker",
        "clientSecret": "${DC2_BROKER_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "loginHint": "true",
        "disableUserInfo": "true",
        "sendIdTokenOnLogout": "true",
        "backchannelSupported": "false",
        "syncMode": "FORCE",
        "home.idp.discovery.domains": "dc2.test"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "opaque-username",
      "identityProviderAlias": "dc-1",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "template": "${ALIAS}.${CLAIM.sub}"
      }
    },
    {
      "name": "groups",
      "identityProviderAlias": "dc-1",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "groups",
        "user.attribute": "groups"
      }
    },
    {
      "name": "opaque-username",
      "identityProviderAlias": "dc-2",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "template": "${ALIAS}.${CLAIM.sub}"
      }
    },
    {
      "name": "groups",
      "identityProviderAlias": "dc-2",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "groups",
        "user.attribute": "groups"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}, \"pattern\": {\"pattern\": \"^[^@]+$\", \"error-message\": \"Usernames cannot contain @.\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}, \"pattern\": {\"pattern\": \"(?i)^(?!.*@(dc1\\\\.test|dc2\\\\.test)$).*$\", \"error-message\": \"This email domain belongs to a business customer. Sign in with your company account instead.\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}], \"unmanagedAttributePolicy\": \"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "gateway",
      "name": "API gateway (oauth2-proxy)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://babylon.test/oauth2/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://babylon.test/"
      },
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "gateway",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "control-plane",
      "name": "Control plane (provisioning)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${CENTRAL_CONTROL_PLANE_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-control-plane",
      "enabled": true,
      "serviceAccountClientId": "control-plane",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "view-identity-providers"
        ]
      }
    }
  ]
}
