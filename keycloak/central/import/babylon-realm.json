{
  "realm": "babylon",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "browserFlow": "home-idp-discovery",
  "authenticationFlows": [
    {
      "alias": "home-idp-discovery",
      "description": "Existing session, otherwise route to the DC by email domain",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "discover-dc",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "discover-dc",
      "description": "",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "home-idp-discovery",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "broker-create-user",
      "description": "Create the brokered user without prompting or storing a profile",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "dc-1",
      "displayName": "dc-1",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "hideOnLogin": true,
      "firstBrokerLoginFlowAlias": "broker-create-user",
      "config": {
        "issuer": "http://auth.dc-1.babylon.test/realms/babylon",
        "authorizationUrl": "http://auth.dc-1.babylon.test/realms/babylon/protocol/openid-connect/auth",
        "tokenUrl": "http://auth.dc-1.babylon.test/realms/babylon/protocol/openid-connect/token",
        "jwksUrl": "http://auth.dc-1.babylon.test/realms/babylon/protocol/openid-connect/certs",
        "logoutUrl": "http://auth.dc-1.babylon.test/realms/babylon/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "central-broker",
        "clientSecret": "${DC1_BROKER_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "loginHint": "true",
        "disableUserInfo": "true",
        "sendIdTokenOnLogout": "true",
        "backchannelSupported": "false",
        "syncMode": "FORCE",
        "home.idp.discovery.domains": "school-a.test"
      }
    },
    {
      "alias": "dc-2",
      "displayName": "dc-2",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "hideOnLogin": true,
      "firstBrokerLoginFlowAlias": "broker-create-user",
      "config": {
        "issuer": "http://auth.dc-2.babylon.test/realms/babylon",
        "authorizationUrl": "http://auth.dc-2.babylon.test/realms/babylon/protocol/openid-connect/auth",
        "tokenUrl": "http://auth.dc-2.babylon.test/realms/babylon/protocol/openid-connect/token",
        "jwksUrl": "http://auth.dc-2.babylon.test/realms/babylon/protocol/openid-connect/certs",
        "logoutUrl": "http://auth.dc-2.babylon.test/realms/babylon/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "central-broker",
        "clientSecret": "${DC2_BROKER_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "loginHint": "true",
        "disableUserInfo": "true",
        "sendIdTokenOnLogout": "true",
        "backchannelSupported": "false",
        "syncMode": "FORCE",
        "home.idp.discovery.domains": "school-b.test"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "opaque-username",
      "identityProviderAlias": "dc-1",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "template": "${ALIAS}.${CLAIM.sub}"
      }
    },
    {
      "name": "groups",
      "identityProviderAlias": "dc-1",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "groups",
        "user.attribute": "groups"
      }
    },
    {
      "name": "opaque-username",
      "identityProviderAlias": "dc-2",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "template": "${ALIAS}.${CLAIM.sub}"
      }
    },
    {
      "name": "groups",
      "identityProviderAlias": "dc-2",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "groups",
        "user.attribute": "groups"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}}, {\"name\": \"email\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}}], \"unmanagedAttributePolicy\": \"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "gateway",
      "name": "API gateway (oauth2-proxy)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://babylon.test/oauth2/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://babylon.test/"
      },
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "gateway",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
