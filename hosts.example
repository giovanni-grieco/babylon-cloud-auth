# Reference for local development: add the Babylon line to /etc/hosts.
# Keep your existing localhost lines. This file isn't read automatically.
#
# Check it with: getent hosts auth.dc-1.babylon.test

127.0.0.1   localhost localhost.localdomain
::1         localhost localhost.localdomain

# Babylon: nginx routes these names using the HTTP Host header
#   babylon.test            mock services, through the API gateways
#   auth.babylon.test       central Keycloak (single login point)
#   auth.dc-1.babylon.test  dc-1 Keycloak (school-a.test users)
#   auth.dc-2.babylon.test  dc-2 Keycloak (school-b.test users)
#   control-plane.babylon.test  operator console for provisioning B2B accounts
127.0.0.1   babylon.test auth.babylon.test auth.dc-1.babylon.test auth.dc-2.babylon.test control-plane.babylon.test
