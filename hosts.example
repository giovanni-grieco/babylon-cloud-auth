# Reference for local development: add the Babylon line to /etc/hosts.
# Keep your existing localhost lines. This file isn't read automatically.
#
# Check it with: getent hosts auth.dc1.babylon.test

127.0.0.1   localhost localhost.localdomain
::1         localhost localhost.localdomain


127.0.0.1  babylon.test dc1.babylon.test dc2.babylon.test auth.babylon.test auth.dc1.babylon.test auth.dc2.babylon.test control-plane.babylon.test auth.control-plane.babylon.test
